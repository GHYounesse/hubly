{% if hebergements is not empty %}
<div class="table-responsive">
    <table class="table table-striped table-bordered  ">
        <thead>
            <tr>
                <th>Nom de domaine  </th>
                <th>Fournisseur  </th>
                <th>Type  </th>
                <th>Statut</th>
                <th>Url</th>
                <th>Date d'expiration</th>
                <th style="text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for hebergement in hebergements %}
            <tr>
                <td>{{hebergement.site}}</td>
                <td>{{hebergement.fournisseur}}</td>
                <td> {{hebergement.type}}</td>
                <td>
                    {% if hebergement.estActif %}
                        <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-sm font-medium text-green-800 dark:bg-green-900 dark:text-green-300">
                            Actif
                        </span>
                    {% else %}
                        <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-sm font-medium text-red-800 dark:bg-red-900 dark:text-red-300">
                            Inactif
                        </span>
                    {% endif %}
                </td>
                <td><a href="{{hebergement.url}}" target="_blank">{{hebergement.url}}</a></td>
                <td>{{hebergement.dateExpiration ? hebergement.dateExpiration|date('d/m/Y') : ''}}</td>
                <td style="text-align:center;">
                    <button type="button" class="btn btn-outline-secondary btn-rounded btn-icon update" title="modifier" data-id="{{ hebergement.id }}" data-nom="{{ hebergement.site }}" command="show-modal" commandfor="hebergementModal">
                            <i class="typcn typcn-edit text-infos"></i>
                    </button>
                    <form method="post" action="{{ path('app_hebergement_delete', { id: hebergement.id }) }}" class="inline delete-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~  hebergement.id) }}">
                        <button type="button" class="hover:!bg-transparent delete-btn btn btn-outline-secondary btn-rounded btn-icon delete" title="supprimer" data-id="{{ hebergement.id }}" data-nom="{{ hebergement.site }} - {{ hebergement.fournisseur }}">
                            <i class="mdi mdi-broom text-danger"></i>
                        </button>
                    </form>
                    
                    <button type="button" class="btn btn-outline-secondary btn-rounded btn-icon show d-none" title="plus d'informations" data-id="{{ hebergement.id }}" data-nom="{{ hebergement.site }}">
                            <i class="mdi mdi-eye text-info"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
     </table>
     </div>
{% else %}
    <div class="alert alert-warning">Aucun hebergement  trouvé avec ce nom du fournisseur .</div>
{% endif %}
