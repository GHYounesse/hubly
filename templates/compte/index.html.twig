{% extends 'layout/admin.html.twig' %}

{% block title %}Compte - {{appName}}{% endblock %}

{% block stylesheets %}
<style>
   .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
        </style>
{% endblock %}

{% block body %}
<div class="content-wrapper">
    
    <div class="form-page">
      <div class="form-band">
        <h2 class="text-2xl font-bold text-white">Informations du Compte</h2>
        <p class="mt-1">Détails de votre profil utilisateur</p>
      </div>
      
      <div class="p-8">
        <div class="space-y-6">
          <!-- Row 1 -->
          <div class="flex items-center pb-6 border-b border-gray-200">
            <div class="w-1/3">
              <span class="text-sm font-semibold text-gray-600">Prénom</span>
            </div>
            <div class="w-2/3">
              <span class="text-lg font-medium text-gray-900">{{user.prenom}}</span>
            </div>
          </div>

          <!-- Row 2 -->
          <div class="flex items-center pb-6 border-b border-gray-200">
            <div class="w-1/3">
              <span class="text-sm font-semibold text-gray-600">Nom</span>
            </div>
            <div class="w-2/3">
              <span class="text-lg font-medium text-gray-900">{{user.nom}}</span>
            </div>
          </div>

          <!-- Row 3 -->
          <div class="flex items-center pb-6 border-b border-gray-200">
            <div class="w-1/3">
              <span class="text-sm font-semibold text-gray-600">Email</span>
            </div>
            <div class="w-2/3">
              <span class="text-lg font-medium text-gray-900">{{user.email}}</span>
            </div>
          </div>

          <!-- Row 4 -->
          <div class="flex items-center pb-6 border-b border-gray-200">
            <div class="w-1/3">
              <span class="text-sm font-semibold text-gray-600">Statut</span>
            </div>
            <div class="w-2/3">
              <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                {{user.statut}}
              </span>
            </div>
          </div>

          <!-- Row 5 -->
          <div class="flex items-start">
            <div class="w-1/3">
              <span class="text-sm font-semibold text-gray-600">Rôles</span>
            </div>
            <div class="w-2/3">
                
              <div class="flex flex-wrap gap-2">
                {% for role in user.roles %}
                    <span class="inline-flex items-center px-4 py-1.5 rounded-lg text-sm font-semibold
                                bg-blue-100 text-blue-800 border border-blue-200">
                        {{ role }}
                    </span>
                {% endfor %}
                
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 flex justify-end">
          <a href="{{ path('app_dashboard') }}" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition-colors">
            Retour au tableau de bord
          </a>
        </div>
      </div>
    </div>
</div>

{% endblock %}
