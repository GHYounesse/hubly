{% block scripts %}
<script>
// Gestion du formulaire de recherche AJAX en jQuery
function initDeveloperSelect2() {
    const $container = $('#developerModal-form');
    const $select = $container.find('select.select2');

    if (!$select.length) return;

    // If re-rendering the form, destroy old instance first
    if ($select.hasClass('select2-hidden-accessible')) {
      $select.select2('destroy');
    }

    $select.select2({
      width: '100%',
      dropdownParent: $container,
      placeholder: 'Choisir un utilisateur',
      allowClear: true
    });
  }

$(document).ready(function () {
    $('#name').hide();
    $.ajax({
        type: "GET",
        url: "/developpeur/new",
        cache: false,
        success: function (data) {
            // Injecter la réponse dans la modal
            //$('#developerModal .modal-body').html(data);
            // Afficher la modal
            //$('#developerModal').modal('show');
            $('#developerModal-form').html(data);
            initDeveloperSelect2();
        },
        error: function (e) {
            console.error("Erreur lors du chargement :", e);
        }
    });


    $('#search-form').on('submit', function (event) {
        event.preventDefault();

        const formData = new FormData(this);
        const $searchResultsContainer = $('#search-results');
        const $globalTableContainer = $('#global-table-container');
        const $loadingSpinner = $('#loading-spinner');

        // Affiche le spinner et cache le tableau global
        $loadingSpinner.show();
        $globalTableContainer.hide();

        $.ajax({
            url: '{{ path("app_developpeur_index") }}',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function (html) {
                $searchResultsContainer.html(html).show();
                $loadingSpinner.hide();
            },
            error: function (xhr, status, error) {
                console.error('Erreur lors de la recherche:', error);
                $globalTableContainer.show();
                $searchResultsContainer.hide();
                $loadingSpinner.hide();
            }
        });
    });
});

