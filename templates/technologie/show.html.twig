
<h6 class="mb-3 font-semibold text-gray-700">Projets</h6>

<div class="search-container mb-3">
    <form id="search-form" class="d-flex">
    <input type="hidden" id="search-techId" value="{{ technologie.id }}">
        <input
            type="text"
            name="search"
            id="search-input"
            class="form-control me-2"
            placeholder="Rechercher"
        >
        <button type="button" id="search-button" class="btn btn-sm btn-info">
            <i class="bi bi-search"></i>
        </button>
    </form>
</div>

{% if projets|length > 0 %}
    <!-- SCROLL CONTAINER -->
    <div id="projects-container" class="overflow-y-auto pr-2
                scrollbar-thin scrollbar-thumb-blue-300 scrollbar-track-transparent"
                style="max-height: 12rem;">

        <!-- CONTENT -->
        <div class="flex flex-wrap gap-2">
            {% for projet in projets %}
                <a href="/projets/show/{{ projet.id }}"
                   class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm text-blue-700
                          hover:bg-blue-200 hover:text-blue-900 transition">
                    {{ projet.nom }}
                </a>
            {% endfor %}
        </div>

    </div>

  
{% else %}
    <p class="italic text-gray-400">
        Aucun projet associé à cette technologie.
    </p>
{% endif %}
<script>
document.getElementById('search-button').addEventListener('click', function (e) {
    e.preventDefault();   
    const search = document.getElementById('search-input').value;
    const form = document.getElementById('search-form');
    const techId = document.getElementById('search-techId').value;

    console.log('Searching for:', search, 'in technology ID:', techId);

    fetch(`/technologie/${techId}/search`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ search })
    })
    .then(response => response.text())
    .then(html => {
        document.getElementById('projects-container').innerHTML = html;
    });
});
</script>