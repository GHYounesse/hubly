


{% if technologies is not empty %}
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

    {% for technologie in technologies %}
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">

            <!-- Header -->
            <div class="mb-3 flex items-center justify-between">
                <div>
                    {% if technologie.logo %}
                    <img src={{ asset(technologie.logo) }} alt={{ technologie.nom }} class="size-14 flex-none rounded-lg bg-white object-cover ring-1 ring-gray-900/10 dark:bg-gray-700 dark:ring-white/10"/>
                    {% endif %}
                    <h3 class="text-lg font-semibold text-gray-800">
                        {{ technologie.nom }}
                    </h3>
                    <p class="text-sm text-gray-500">
                        {{ technologie.version }}
                    </p>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end gap-2" style="align-items: center;">
                <button
                    class="rounded-md bg-green-50 px-2 py-1 text-xs font-medium hover:!shadow-inherit text-green-700 hover:!text-green-700 !border !border-green-600/20 dark:bg-green-400/10 dark:text-green-400 dark:ring-green-500/20 update"
                    title="Modifier"
                    command="show-modal" commandfor="technologieUpdateModal"
                    data-id="{{ technologie.id }}"
                    data-nom="{{ technologie.nom }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
													<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
												</svg>
                </button>

                
                <form method="post"
                      action="{{ path('app_technologie_delete', { id: technologie.id }) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete' ~ technologie.id) }}">
                    <button
                        type="button"
                        class="rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 !border !border-red-600/10 dark:bg-red-400/10 dark:text-red-400 dark:ring-red-400/20 delete"
                        command="show-modal" commandfor="dialog"
                        title="Supprimer"
                        data-id="{{ technologie.id }}"
                        data-nom="{{ technologie.nom }}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
														<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
													</svg>
                    </button>
                </form>

                <button
                    class="rounded-md bg-blue-50 px-2 py-1 text-xs font-medium hover:!shadow-inherit text-blue-700 hover:!text-blue-700 !border !border-blue-600/20 dark:bg-blue-400/10 dark:text-blue-400 dark:ring-blue-500/20 show"
                    title="Voir"
                    data-id="{{ technologie.id }}"
                    data-nom="{{ technologie.nom }}">
                    <i class="mdi mdi-eye text-info"></i>
                </button>
            </div>

        </div>
    {% endfor %}

</div>
{% else %}
    <div class="rounded-lg bg-yellow-50 p-4 text-yellow-700">
        Aucune technologie trouvée avec ce nom.
    </div>
{% endif %}

