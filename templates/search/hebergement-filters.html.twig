<section aria-labelledby="filter-heading" class="grid items-center mb-6">
        <h2 id="filter-heading" class="sr-only">Filtres</h2>
        
        <div class="rounded-t relative col-start-1 row-start-1 py-4 bg-[#f3f4f6]">
            <div class="mx-auto flex justify-between container divide-x divide-gray-200 px-4 text-sm sm:px-6 lg:px-8">
                <div class="flex items-center space-x-4">
                <div class="pr-6">
                    <button type="button" class="group flex items-center font-medium text-gray-700" aria-controls="disclosure-1" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mr-2 size-5 flex-none text-gray-400 group-hover:text-gray-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
                        </svg>
                        <span id="filter-count">0</span>&nbsp;Filtres
                    </button>
                </div>
                <p class="font-medium text-gray-700 pr-6 pl-6">
                    {% if total_hebergements == 0 %}
                        0 hébergement trouvé
                    {% elseif total_hebergements == 1 %}
                        1 hébergement trouvé
                    {% else %}
                        {{ total_hebergements }} hébergements trouvés
                    {% endif %}
                </p>
                <div class="pl-6 pr-6">
                    <button type="button" class="text-[#e7000b] flex items-center" id="clear-all-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1 lucide lucide-rotate-ccw size-4">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                            <path d="M3 3v5h5"></path>
                        </svg>
                        Réinitialiser
                    </button>
                </div>
                </div>
                <div class="d-flex align-items-center justify-content-end">
                            <div>
                                <button class="btn btn-sm btn-info new d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-2" command="show-modal" commandfor="hebergementModal" type="button">
                                    <i class="bi bi-plus-lg fs-5 d-flex align-items-center"></i>
                                    <span class="fw-semibold">Nouveau</span>
                                </button>
                            </div>
                </div>
            </div>
        </div>
        
        <div class="bg-[#f3f4f6] rounded-b-md border-t border-gray-200 py-10" id="disclosure-1" style="display: none;">
            <form id="filter-form" method="GET">
                {# Preserve search term if exists #}
                {% if app.request.query.get('search') %}
                    <input type="hidden" name="search" value="{{ app.request.query.get('search') }}">
                {% endif %}
                
                <div class="container mx-auto px-4 text-sm sm:px-6 lg:px-8">
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:grid-cols-4">
                        
                        {# Type Filter #}
                        <fieldset class="sm:col-span-1">
                            <legend class="text-sm font-medium text-gray-900 mb-2">Type</legend>
                            <select name="type" id="type"
                                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                                <option value="">-- Tous --</option>
                                {% for typeItem in all_types %}
                                    {% if typeItem.type %}
                                        <option value="{{ typeItem.type }}" {{ app.request.query.get('type') == typeItem.type ? 'selected' : '' }}>
                                            {{ typeItem.type }}
                                        </option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </fieldset>

                        {# Fournisseur Filter #}
                        <fieldset>
                            <legend class="text-sm font-medium text-gray-900 mb-2">Fournisseur</legend>
                            <select name="fournisseur" id="fournisseur"
                                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                                <option value="">-- Tous --</option>
                                {% for fournisseurItem in all_fournisseurs %}
                                    {% if fournisseurItem.fournisseur %}
                                        <option value="{{ fournisseurItem.fournisseur }}" {{ app.request.query.get('fournisseur') == fournisseurItem.fournisseur ? 'selected' : '' }}>
                                            {{ fournisseurItem.fournisseur }}
                                        </option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </fieldset>

                        {# Status (Active/Inactive) Filter #}
                        <fieldset>
                            <legend class="text-sm font-medium text-gray-900 mb-2">Statut</legend>
                            <select name="est_actif" id="est_actif"
                                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                                <option value="">-- Actifs seulement --</option>
                                <option value="all" {{ app.request.query.get('est_actif') == 'all' ? 'selected' : '' }}>Tous</option>
                                <option value="true" {{ app.request.query.get('est_actif') == 'true' ? 'selected' : '' }}>Actifs</option>
                                <option value="false" {{ app.request.query.get('est_actif') == 'false' ? 'selected' : '' }}>Inactifs</option>
                            </select>
                        </fieldset>

                        {# Expiration Date Filter #}
                        <fieldset>
                            <legend class="text-sm font-medium text-gray-900 mb-2">Expiration</legend>
                            <select name="expiration" id="expiration"
                                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                                <option value="">-- Tous --</option>
                                <option value="expired" {{ app.request.query.get('expiration') == 'expired' ? 'selected' : '' }}>Expirés</option>
                                <option value="30days" {{ app.request.query.get('expiration') == '30days' ? 'selected' : '' }}>Expire dans 30 jours</option>
                                <option value="60days" {{ app.request.query.get('expiration') == '60days' ? 'selected' : '' }}>Expire dans 60 jours</option>
                                <option value="90days" {{ app.request.query.get('expiration') == '90days' ? 'selected' : '' }}>Expire dans 90 jours</option>
                            </select>
                        </fieldset>

                    </div>

                    <button type="submit" id="submit-btn" class="mt-4 rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:shadow-none dark:hover:bg-blue-400 dark:focus-visible:outline-blue-500">
                        Appliquer les filtres
                    </button>
                </div>
            </form>
        </div>
    </section>


    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleButton = document.querySelector('[aria-controls="disclosure-1"]');
        const disclosure = document.getElementById("disclosure-1");
        const filterForm = document.getElementById("filter-form");
        const filterCountSpan = document.getElementById("filter-count");
        const clearAllBtn = document.getElementById("clear-all-btn");
        const submitBtn = document.getElementById("submit-btn");

        // Toggle filter panel
        toggleButton.addEventListener("click", () => {
            const isExpanded = toggleButton.getAttribute("aria-expanded") === "true";
            toggleButton.setAttribute("aria-expanded", !isExpanded);
            disclosure.style.display = isExpanded ? "none" : "block";
        });

        // Count active filters
        function updateFilterCount() {
            const params = new URLSearchParams(window.location.search);
            
            let count = 0;
            const filterParams = ['type', 'fournisseur', 'est_actif', 'expiration'];
            
            filterParams.forEach(param => {
                const value = params.get(param);
                if (value && value !== '') {
                    count++;
                }
            });
            
            filterCountSpan.textContent = count;
        }

        updateFilterCount();

        // Clear all filters
        clearAllBtn.addEventListener("click", () => {
            window.location.href = window.location.pathname;
        });

        submitBtn.addEventListener('click', (e) => {
            e.preventDefault();
            filterForm.submit();
        });
    });
</script>