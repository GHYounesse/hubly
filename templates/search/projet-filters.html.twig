<section aria-labelledby="filter-heading" class="grid items-center">
    <h2 id="filter-heading" class="sr-only">Filtres</h2>
    <div class="rounded-t relative col-start-1 row-start-1 py-4 bg-[#f3f4f6]">
      <div class="mx-auto flex container divide-x divide-gray-200 px-4 text-sm sm:px-6 lg:px-8">
        <div class="pr-6">
          <button type="button" class="group flex items-center font-medium text-gray-700" aria-controls="disclosure-1" aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mr-2 size-5 flex-none text-gray-400 group-hover:text-gray-500">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
            </svg>
            <span id="filter-count">0</span>&nbsp;Filtres
          </button>
        </div>
        <p class="font-medium text-gray-700 pr-6 pl-6">
            {% if total_projets == 0 %}
                0 projet trouvé
            {% elseif total_projets == 1 %}
                1 projet trouvé
            {% else  %}
                {{ total_projets }} projets trouvé
            {% endif  %}
        </p>
        <div class="pl-6 pr-6">
          <button type="button" class="text-[#e7000b] flex items-center" id="clear-all-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1 lucide lucide-rotate-ccw size-4">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path>
            </svg>
            Réinitialiser
          </button>
        </div>
      </div>
    </div>
    
    <div class="bg-[#f3f4f6] rounded-b-md border-t border-gray-200 py-10" id="disclosure-1" style="display: none;">
      <form id="filter-form" method="GET">
        <div class="container mx-auto px-4 text-sm sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:grid-cols-4">
            
            <!-- Status Filter -->
            <fieldset class="sm:col-span-1">
              <legend class="text-sm font-medium text-gray-900 mb-2">Statut</legend>
              <select name="status" id="status"
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                <option value="à faire" {{ app.request.query.get('status') == 'à faire' ? 'selected' : '' }}>À faire</option>
                <option value="en cours" {{ app.request.query.get('status') == 'en cours' ? 'selected' : '' }}>En cours</option>
                <option value="terminé" {{ app.request.query.get('status') == 'terminé' ? 'selected' : '' }}>Terminé</option>
              </select>
            </fieldset>

            <!-- Priorité Filter -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Priorité</legend>
              <select name="priorite" id="priorite"
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                <option value="normal" {{ app.request.query.get('priorite') == 'normal' ? 'selected' : '' }}>Normal</option>
                <option value="moyen" {{ app.request.query.get('priorite') == 'moyen' ? 'selected' : '' }}>Moyen</option>
                <option value="urgent" {{ app.request.query.get('priorite') == 'urgent' ? 'selected' : '' }}>Urgent</option>
                <option value="tres urgent" {{ app.request.query.get('priorite') == 'tres urgent' ? 'selected' : '' }}>Très urgent</option>
              </select>
            </fieldset>

            <!-- Type Filter -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Type</legend>
              <select name="type" id="type"
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                <option value="web" {{ app.request.query.get('type') == 'web' ? 'selected' : '' }}>Web</option>
                <option value="mobile" {{ app.request.query.get('type') == 'mobile' ? 'selected' : '' }}>Mobile</option>
                <option value="desktop" {{ app.request.query.get('type') == 'desktop' ? 'selected' : '' }}>Desktop</option>
              </select>
            </fieldset>

            <!-- Suivi Par Filter -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Suivi par</legend>
              <select name="suivi_par_id" id="suivi_par_id" 
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                {% if users|length > 0 %}
                  {% for user in users %}
                    <option value="{{ user.id }}" {% if app.request.query.get('suivi_par_id')|default(0) == user.id %}selected{% endif %}>
                      {{ user.nom }} {{ user.prenom }}
                    </option>
                  {% endfor %}
                {% endif %}
              </select>
            </fieldset>

            <!-- Développeur Principal Filter -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Développeur Principal</legend>
              <select name="developpeur_principal_id" id="developpeur_principal_id"
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                {% if developpeurs|length > 0 %}
                  {% for dev in developpeurs %}
                    <option value="{{ dev.id }}" {% if app.request.query.get('developpeur_principal_id')|default(0) == dev.id %}selected{% endif %}>
                      {{ dev.nom }} {{ dev.prenom }}
                    </option>
                  {% endfor %}
                {% endif %}
              </select>
            </fieldset>

            <!-- Commercial Filter -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Commercial</legend>
              <select name="commercial_id" id="commercial_id"
                class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                <option value="">-- Tous --</option>
                {% if users|length > 0 %}
                  {% for user in users %}
                    <option value="{{ user.id }}" {% if app.request.query.get('commercial_id')|default(0) == user.id %}selected{% endif %}>
                      {{ user.nom }} {{ user.prenom }}
                    </option>
                  {% endfor %}
                {% endif %}
              </select>
            </fieldset>

            <!-- Boolean Filters - état projet -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">État du projet</legend>
              <div class="space-y-3">
                <select name="etat_projet" id="etat_projet"
                  class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                  <option value="">-- Tous --</option>
                    <option value="projet_teste" {% if app.request.query.get('etat_projet')|default(0) == 'projet_teste' %}selected{% endif %}>
                      Projet testé
                    </option>
                    <option value="projet_valide" {% if app.request.query.get('etat_projet')|default(0) == 'projet_valide' %}selected{% endif %}>
                      Projet validé
                    </option>
                    <option value="teste_valide" {% if app.request.query.get('etat_projet')|default(0) == 'teste_valide' %}selected{% endif %}>
                      Projet testé et validé
                    </option>
                </select>
              </div>
            </fieldset>

            <!-- Client Filters -->
            <fieldset>
              <legend class="text-sm font-medium text-gray-900 mb-2">Client</legend>
              <div class="space-y-3">
                <select name="client" id="client"
                  class="w-full rounded-md !border !border-gray-300 px-3 py-2 text-sm focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-600">
                  <option value="">-- Tous --</option>
                    <option value="client_gratuite" {% if app.request.query.get('client')|default(0) == 'client_gratuite' %}selected{% endif %}>
                      A consommé la gratuité
                    </option>
                    <option value="client_ameliorations" {% if app.request.query.get('client')|default(0) == 'client_ameliorations' %}selected{% endif %}>
                      A demandé des améliorations
                    </option>
                    <option value="gratuite_amelioration" {% if app.request.query.get('client')|default(0) == 'gratuite_amelioration' %}selected{% endif %}>
                      Gratuité & Améliorations
                    </option>
                </select>
              </div>
            </fieldset>
          </div>

          <button type="submit" id="submit-btn" class="mt-4 rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:shadow-none dark:hover:bg-blue-400 dark:focus-visible:outline-blue-500">Appliquer les filtres</button>
        </div>
      </form>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleButton = document.querySelector('[aria-controls="disclosure-1"]');
        const disclosure = document.getElementById("disclosure-1");
        const filterForm = document.getElementById("filter-form");
        const filterCountSpan = document.getElementById("filter-count");
        const clearAllBtn = document.getElementById("clear-all-btn");
        const submitBtn = document.getElementById("submit-btn");

        // Toggle filter panel
        toggleButton.addEventListener("click", () => {
            const isExpanded = toggleButton.getAttribute("aria-expanded") === "true";
            toggleButton.setAttribute("aria-expanded", !isExpanded);
            disclosure.style.display = isExpanded ? "none" : "block";
        });

        // Count active filters
        function updateFilterCount() {
            const params = new URLSearchParams(window.location.search);
            
            let count = 0;
            const filterParams = ['type', 'status', 'suivi_par_id', 'developpeur_principal_id', 'commercial_id', 'priorite', 'projet_teste', 'projet_valide', 'etat_projet', 'client'];
            
            filterParams.forEach(param => {
                if (params.get(param)) {
                  count++;
                }
            });
            
            filterCountSpan.textContent = count;
        }

        updateFilterCount();

        // Clear all filters
        clearAllBtn.addEventListener("click", () => {
            window.location.href = window.location.pathname;
        });

        submitBtn.addEventListener('click', () => {
            filterForm.submit();
        });
    });
</script>
