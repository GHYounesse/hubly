{% extends 'layout/admin.html.twig' %}

{% block title %}Projets - {{appName}}{% endblock %}

{% block body %}
	<div class="content-wrapper">
		{% include 'layout/_page_header.html.twig' with {
			title: 'Sociétés',
			subtitle: 'Vos clients et les projets rattachés à chacun.',
			action: is_granted('ROLE_ADMIN') ? { label: 'Ajouter une société', href: path('app_societe_new') } : null
		} %}
		<div class="panel p-3">
			<div class="d-none"></div>
			<div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">

				{% if societes is empty %}
					<h2 class="!mt-10 text-3xl text-gray-700">Aucune société disponible.</h2>
				{% else %}
					<ul role="list" class="my-8 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-3 xl:gap-x-8">
						{% for societe in societes %}
							<li class="bg-white overflow-hidden rounded-xl transition duration-500 outline outline-1 outline-gray-200 dark:-outline-offset-1 dark:outline-white/10">
								<div class="flex items-center gap-x-4 border-b border-gray-900/5 p-6 dark:border-white/10 dark:bg-gray-800/50">
									<img src={{ asset(societe.logo) }} alt={{ societe.denomination }} class="size-14 flex-none rounded-lg bg-white object-cover ring-1 ring-gray-900/10 dark:bg-gray-700 dark:ring-white/10"/>
									<div>
										<div class="text-sm/6 font-medium text-gray-900 dark:text-white">{{ societe.denomination }}</div>
										<p class="text-xs text-gray-400 dark:text-gray-400 line-clamp-2">{{ societe.description }}</p>
									</div>
								</div>
								<dl class="-my-3 divide-y divide-gray-100 px-6 py-4 text-sm/6 dark:divide-white/10">
									<div class="flex justify-between gap-x-4 py-3">

										<div class="flex items-center justify-between">
											{% if is_granted('ROLE_ADMIN') %}
											<a class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium hover:!shadow-inherit text-green-700 hover:!text-green-700 !border !border-green-600/20 dark:bg-green-400/10 dark:text-green-400 dark:ring-green-500/20" href="{{path('app_societe_edit', {id: societe.id})}}">
												<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
													<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
												</svg>
											</a>
											{% endif %}
										</div>

										<dd class="group flex items-start justify-end gap-x-2">
											<a href={{ path('app_societe_projets', { id: societe.id } ) }} class="cursor-pointer inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 !border !border-blue-700/10 dark:bg-blue-400/10 dark:text-blue-400 dark:ring-blue-400/30 !no-underline focus:no-underline active:no-underline visited:no-underline">
												Voir les projets
												<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="group-hover:animate-bounce-x ml-2 size-4">
													<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"/>
												</svg>
											</a>
										</dd>
									</div>
								</dl>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>
		</div>
	</div>

	<div class="mt-6">
		{{ knp_pagination_render(societes, 'pagination/tailwind_pagination.html.twig') }}
	</div>

	<el-dialog>
		<dialog id="dialog" aria-labelledby="dialog-title" class="fixed inset-0 m-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent p-0 backdrop:bg-transparent">
			<el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-[closed]:opacity-0 data-[enter]:duration-300 data-[leave]:duration-200 data-[enter]:ease-out data-[leave]:ease-in dark:bg-gray-900/50"></el-dialog-backdrop>

			<div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline focus:outline-0 sm:items-center sm:p-0">
				<el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all data-[closed]:translate-y-4 data-[closed]:opacity-0 data-[enter]:duration-300 data-[leave]:duration-200 data-[enter]:ease-out data-[leave]:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-[closed]:sm:translate-y-0 data-[closed]:sm:scale-95 dark:bg-gray-800 dark:outline dark:outline-1 dark:-outline-offset-1 dark:outline-white/10">
					<div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
						<button type="button" command="close" commandfor="dialog" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-indigo-600 dark:bg-gray-800 dark:hover:text-gray-300 dark:focus:outline-white">
							<span class="sr-only">Close</span>
							<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
								<path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</button>
					</div>
					<div class="sm:flex sm:items-start">
						<div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:size-10 dark:bg-red-500/10">
							<svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-red-600 dark:text-red-400">
								<path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</div>
						<div class="!mt-3 !text-center sm:!ml-4 sm:!mt-0 sm:!text-left">
							<h3 id="dialog-title" class="text-base !text-left !font-semibold !text-gray-900 dark:text-white">
								Supprimer la société
								<span id="modalSocieteName" class="font-semibold text-gray-900 dark:text-white"></span>
								?
							</h3>
							<div class="mt-2">
								<p class="!text-sm !text-left !text-gray-500 dark:text-gray-400">Cette action est
									<span class="font-semibold text-red-600 dark:text-red-400">définitive</span>
									et entraînera la perte de tous les projets associés.</p>
							</div>
						</div>
					</div>
					<div class="!mt-5 sm:!mt-4 sm:flex sm:!flex-row-reverse">
						<button id="confirm-delete" type="button" command="close" commandfor="dialog" class="inline-flex w-full justify-center rounded-md !bg-red-600 !px-3 !py-2 !text-sm !font-semibold !text-white !shadow-sm hover:!bg-red-500 sm:!ml-3 sm:!w-auto dark:bg-red-500 dark:shadow-none dark:hover:bg-red-400">Supprimer</button>
						<button id="cancel-delete" type="button" command="close" commandfor="dialog" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm !ring-1 !ring-inset !ring-gray-300 hover:bg-gray-50 sm:!mt-0 sm:w-auto dark:bg-white/10 dark:text-white dark:shadow-none dark:ring-white/5 dark:hover:bg-white/20">Cancel</button>
					</div>
				</el-dialog-panel>
			</div>
		</dialog>
	</el-dialog>


{% endblock %}

{% block javascripts %}
	<script>
	document.addEventListener("DOMContentLoaded", () => {
		const modal = document.getElementById("dialog");
		const modalSocieteName = document.getElementById("modalSocieteName");
		const cancelBtn = document.getElementById("cancel-delete");
		const confirmBtn = document.getElementById("confirm-delete");
		let currentForm = null;

		document.querySelectorAll(".delete-btn").forEach(button => {
			button.addEventListener("click", () => {
				const name = button.dataset.name;
				currentForm = button.closest("form");
				modalSocieteName.textContent = `"${name}"`;
				modal.showModal();
			});
		});

		cancelBtn.addEventListener("click", () => {
			currentForm = null;
			modal.close();
		});

		confirmBtn.addEventListener("click", () => {
			if (currentForm) currentForm.submit();
		});
	});
</script>

{% endblock %}
