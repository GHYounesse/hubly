{% extends 'layout/admin.html.twig' %}

{% block title %}Ajouter une Société - {{appName}}{% endblock %}

{% block body %}
	{{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data', 'novalidate': 'novalidate' } }) }}
	<div class="content-wrapper">
		<div class="form-page">
			
			<div class="form-band"><h2>Ajouter une société</h2></div>
			<div
				class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 p-4">
				<!-- Dénomination -->
				<div class="sm:col-span-3">
					{{ form_label(form.denomination, 'Dénomination', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.denomination, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.denomination) }}
					</div>
				</div>

				<!-- Statut -->
				<div class="sm:col-span-3">
					{{ form_label(form.statut, 'Statut', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.statut, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.statut) }}
					</div>
				</div>

				<!-- Adresse -->
				<div class="sm:col-span-3">
					{{ form_label(form.adresse, 'Adresse', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.adresse, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.adresse) }}
					</div>
				</div>

				<!-- ICE -->
				<div class="sm:col-span-3">
					{{ form_label(form.ice, 'ICE', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.ice, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.ice) }}
					</div>
				</div>

				<!-- Email -->
				<div class="sm:col-span-3">
					{{ form_label(form.email, 'Email', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.email, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.email) }}
					</div>
				</div>

				<!-- Téléphone -->
				<div class="sm:col-span-3">
					{{ form_label(form.phone, 'Téléphone', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.phone, { attr: { class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.phone) }}
					</div>
				</div>

				<!-- Utilisateurs -->
				<div class="col-span-full">
					{{ form_label(form.users, 'Utilisateurs', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' }, 
								label_html: true  }) }}
					<div class="mt-2">
						{{ form_widget(form.users, { attr: { class: 'col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-8 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.users) }}
					</div>
				</div>

				<!-- Description -->
				<div class="col-span-full">
					{{ form_label(form.description, 'Description', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}
					<div class="mt-2">
						{{ form_widget(form.description, { attr: { rows: 3, class: 'block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-blue-500' } }) }}
						{{ form_errors(form.description) }}
					</div>
				</div>

				<!-- Logo -->
				<div class="col-span-full">
					{{ form_label(form.logo, 'Logo', { label_attr: { class: 'block text-sm/6 font-medium text-gray-900 dark:text-white' } }) }}

					<div class="mt-2 flex justify-center rounded-lg !border !border-dashed !border-gray-300 px-6 py-10 dark:border-white/25">
						<div class="text-center">
							<svg viewbox="0 0 24 24" fill="currentColor" class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600" id="upload-icon">
								<path d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z" clip-rule="evenodd" fill-rule="evenodd"/>
							</svg>

							<img id="preview-image" class="hidden mx-auto h-24 w-auto object-contain rounded-lg mb-2">

							<div class="mt-4 flex text-sm text-gray-600 dark:text-gray-400 items-center justify-center">
								<label for="{{ form.logo.vars.id }}" class="cursor-pointer !mb-0 rounded-md bg-transparent font-semibold text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300">
									<span>Uploader un fichier</span>
								</label>
								<p class="pl-1">ou glisser-déposer</p>
							</div>

							<p id="logo-filename" class="text-sm text-gray-700 dark:text-gray-300 mt-2"></p>
							<p class="text-xs text-gray-600 dark:text-gray-400 mt-2">PNG, JPG, GIF jusqu'à 2MB</p>

							{{ form_widget(form.logo, { attr: { class: 'sr-only' } }) }}

						</div>
					</div>
					{{ form_errors(form.logo) }}
				</div>
			</div>
			<div class="!my-6 flex items-center justify-end gap-x-6 p-4">
				<a href="{{ path('app_societes') }}" class="text-sm hover:no-underline hover:text-gray-900 px-3 py-2 !border !border-gray-700 !rounded-lg font-semibold text-gray-900 dark:text-white">Annuler</a>
				<button type="submit" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:shadow-none dark:focus-visible:outline-blue-500">
					Enregistrer
				</button>
			</div>
		</div>
	</div>

	
	{{ form_end(form) }}
	
{% endblock %}

{% block javascripts %}

	<script>
		document.addEventListener('DOMContentLoaded', function () {

			const societeUsers = document.getElementById('societe_users');
			
			if (societeUsers && typeof TomSelect !== 'undefined') {
				new TomSelect("#societe_users", {
					plugins: ['remove_button'],
					create: false,
					maxItems: null,
					placeholder: 'Choisissez les utilisateurs...',
					sortField: {
						field: "text",
						direction: "asc"
					},
					onInitialize: function () {
						this.control.classList.add('!border-none', '!px-0',);
					}
				});
			} else {
					console.error("Missing societe users or TomSelect library");
			}

			
		});
		document.addEventListener('DOMContentLoaded', function() {
			const logoInput = document.getElementById('{{ form.logo.vars.id }}');
			const filenameSpan = document.getElementById('logo-filename');
			const previewImage = document.getElementById('preview-image');
			const uploadIcon = document.getElementById('upload-icon');

			if (logoInput) {
				logoInput.addEventListener('change', function () {
					if (this.files && this.files.length > 0) {
						const file = this.files[0];
						filenameSpan.textContent = file.name;

						// Show preview of the image
						const reader = new FileReader();
						reader.onload = function(e) {
							previewImage.src = e.target.result;
							previewImage.classList.remove('hidden');
							uploadIcon.classList.add('hidden');
						};
						reader.readAsDataURL(file);
					} else {
						filenameSpan.textContent = '';
						previewImage.classList.add('hidden');
						uploadIcon.classList.remove('hidden');
					}
				});
			}
		});
	</script>
{% endblock %}