{% if projets is not empty %}
<table class="table table-striped table-bordered">    
    <thead>
        <tr>
            <th class="whitespace-nowrap" style="text-align: center;">Actions</th>
            <th class="whitespace-nowrap">Nom</th>
            <th class="whitespace-nowrap">Type</th>
            <th class="whitespace-nowrap">URL</th>
            <th class="whitespace-nowrap min-w-[250px] max-h-[100px]:">Description</th>
            <th class="whitespace-nowrap" style="text-align: center;">Statut</th>
            <th class="whitespace-nowrap">Suivi par</th>
            <th class="whitespace-nowrap">Developpeur</th>
            <th class="whitespace-nowrap">Remarques</th>
            <th class="whitespace-nowrap">Priorité</th>
            <th class="whitespace-nowrap">Date de livraison</th>
            <th class="whitespace-nowrap">Risque de livraison</th>
            <th class="whitespace-nowrap">Date de commande/avance</th>
            <th class="whitespace-nowrap">Commercial</th>
            <th class="whitespace-nowrap">Projet Testé</th>
            <th class="whitespace-nowrap">Projet validé</th>
            <th class="whitespace-nowrap">Gratuité consommé</th>
            <th class="whitespace-nowrap">Améliorations demandé</th>
        </tr>
    </thead>
    <tbody>
        {% for projet in projets %}
            <tr class="text-center">
                <td class="flex items-center" style="text-align:center;">
                    {# Update #}
                    <a href="{{ path('app_projets_update', { 'id': projet.id, 'societe': societe_id }) }}" 
                    class="hover:!bg-transparent flex justify-center items-center btn btn-outline-secondary btn-rounded btn-icon bg-green-50 px-2 py-1 text-xs font-medium hover:!shadow-inherit text-green-700 hover:!text-green-700 !border !border-green-600/20 dark:bg-green-400/10 dark:text-green-400 dark:ring-green-500/20" 
                    title="modifier" 
                    data-id="{{ projet.id }}" data-nom="{{ projet.nom }}">
                        {# <i class="typcn typcn-edit text-info"></i> #}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
													<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/>
												</svg>
                    </a>
                    
                    
                    {# Delete #}
                    <form method="post" action="{{ path('app_projet_delete', { id: projet.id }) }}" class="inline delete-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~  projet.id) }}">
                        <button type="button" 
                        class="hover:!bg-transparent delete-btn btn btn-outline-secondary btn-rounded btn-icon delete bg-red-50 px-2 py-1 text-xs font-medium text-red-700 !border !border-red-600/10 dark:bg-red-400/10 dark:text-red-400 dark:ring-red-400/20" 
                        style="padding-left:0.4rem !important;padding-right:0,4rem !important;"
                        title="supprimer" data-id="{{ projet.id }}" data-nom="{{ projet.nom }}">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
														<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
													</svg>
                        </button>
                    </form>
                    {# Show #}
                    <a href="{{ path('app_projets_show', { 'id': projet.id }) }}" 
                    class="hover:!bg-transparent flex justify-center items-center  btn btn-outline-secondary btn-rounded btn-icon show bg-blue-50 px-1 py-1 text-xs font-medium hover:!shadow-inherit text-blue-700 hover:!text-blue-700 !border !border-blue-600/20 dark:bg-blue-400/10 dark:text-blue-400 dark:ring-blue-500/20" 
                    title="plus d'informations " data-id="{{ projet.id }}" data-nom="{{ projet.nom }}">
                        <i class="mdi mdi-eye text-info"></i>
                    </a>
                </td>
                <td>{{ projet.nom }}</td>
                <td>{{ projet.type }}</td>
                <td>
                    {% if projet.url %}
                        <a class="!text-blue-700" href="{{ projet.url }}" target="_blank">
                            {{ projet.nom }}
                        </a>
                    {% else %}
                        --------
                    {% endif %}
                </td>
                <td>{{ projet.description ? projet.description : '--------' }}</td>
                <td style="text-align:center;">
                    <span class="badge badge-pill 
                        {% if projet.status == 'à faire' %}badge-primary
                        {% elseif projet.status == 'en cours' %}badge-success
                        {% elseif projet.status == 'terminé' %}badge-info
                        {% else %}badge-primary{% endif %}
                    ">
                        {{ projet.status|capitalize }}
                    </span>
                </td>
                <td>{{ projet.suiviPar ? projet.suiviPar.prenom : '--------' }}</td>
                <td>{{ projet.developpeurPrincipal ? projet.developpeurPrincipal.prenom ~ ' ' ~ projet.developpeurPrincipal.nom : '--------' }}</td>
                <td>{{ projet.remarques ? projet.remarques : '--------'  }}</td>
                <td>
                    {% set priorities = {
                        'normal': 'secondary',
                        'moyen': 'info',
                        'urgent': 'warning',
                        'tres urgent': 'danger'
                    } %}

                    <span class="badge bg-{{ priorities[projet.priorite]|default('secondary') }} rounded-pill text-white">
                        {{ projet.priorite|capitalize }}
                    </span>
                </td>

                <td>{{ projet.dateLivraison ? projet.dateLivraison|date('Y-m-d') : '--------' }}</td>
                <td>{{ projet.risqueLivraison ? projet.description : '--------'  }}</td>
                <td>{{ projet.dateCommande ? projet.dateCommande|date('Y-m-d') : '--------' }}</td>
                <td>{{ projet.commercial ? projet.commercial.prenom : '--------' }}</td>
                <td>
                    <i class="bi {{ projet.projetTeste ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' }}"></i>
                </td>
                <td>
                    <i class="bi {{ projet.projetValide ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' }}"></i>
                </td>
                <td>
                    <i class="bi {{ projet.clientGratuite ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' }}"></i>
                </td>
                <td>
                    <i class="bi {{ projet.clientAmeliorations ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' }}"></i>
                </td>


            </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
    <div class="alert alert-warning">Aucun projet trouvé .</div>
{% endif %}
