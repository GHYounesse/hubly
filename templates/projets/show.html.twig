{% extends 'layout/admin.html.twig' %}

{% block title %}{{ projet.nom }} - {{appName}}{% endblock %}

{% set prioriteBadges = {
    'normal': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200',
    'moyen': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
    'urgent': 'bg-red-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200',
    'tres urgent': 'bg-red-500 text-red-800 dark:bg-red-900 dark:text-red-200'
} %}
{% block body %}
<div class="content-wrapper">
	<!-- Header -->
	
	
	<div class="form-page">
		<div class="form-band">
				{# <h2 class="ml-0 capitalize text-white text-4xl font-bold  py-3" style="margin-left: 0%!important;"> Projet - {{ projet.nom }}</h2> #}
				
				<div class="flex items-center gap-3 py-2">
					<a href="{{ path('app_societe_projets',{'id': projet.societe.id}) }}" 
					   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white/10 hover:bg-white/20 transition-colors group">
						<svg class="w-5 h-5 text-white group-hover:text-blue-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
						</svg>
					</a>
					<h2 class="capitalize text-white text-4xl font-bold" style="margin-left: 0%!important;"> 
						Projet - {{ projet.nom }}
					</h2>
				</div>
				
		</div >
		<div class="px-4 py-2" >
			{# <p class="mt-1 text-sm text-white-500 dark:text-gray-400">Détails du projet</p> #}
			{# <div class="mb-8">
				<div class="flex items-center justify-between">
					
					
					<div class="flex items-center gap-2">
						{% if projet.projetValide %}
							<span class="inline-flex items-center rounded-md bg-green-50 px-3 py-1 text-sm font-medium text-green-700 ring-1 ring-inset ring-green-600/20 dark:bg-green-500/10 dark:text-green-400 dark:ring-green-500/20">
								Validé
							</span>
						{% endif %}
						{% if projet.projetTeste %}
							<span class="inline-flex items-center rounded-md bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20 dark:bg-blue-500/10 dark:text-blue-400 dark:ring-blue-500/20">
								Testé
							</span>
						{% endif %}
					</div>
				</div>
			</div> #}

			<!-- Main Content Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				
				<!-- Informations Générales -->
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Informations Générales
					</h2>
					<dl class="space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Type</dt>
								<dd class="mt-1 text-sm text-gray-900 dark:text-white">{{ projet.type ?? '-' }}</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Société</dt>
								<dd class="mt-1 text-sm text-gray-900 dark:text-white truncate max-w-[260px]">{{ projet.societe.denomination ?? '-' }}</dd>
							</div>
						</div>
						
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">URL</dt>
								<dd class="mt-1 text-sm text-gray-900 dark:text-white">
									{% if projet.url %}
										<a href="{{ projet.url }}" target="_blank" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 underline">
											{{ projet.url }}
										</a>
									{% else %}
										-
									{% endif %}
								</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">
									Priorité
								</dt>

								<dd class="mt-1">
									{% if projet.priorite %}
										<span class="
											inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
											{{ prioriteBadges[projet.priorite] ?? 'bg-gray-100 text-gray-800' }}
										">
											{{ projet.priorite|capitalize }}
										</span>
									{% else %}
										<span class="text-sm text-gray-400">-</span>
									{% endif %}
								</dd>
							</div>
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Description</dt>
								<dd class="mt-1 text-sm text-gray-900 dark:text-white">{{ projet.description ?? '-' }}</dd>
							</div>
						
					</dl>
				</div>

				<!-- Accès & Technique -->
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Accès & Technique
					</h2>
					<dl class="space-y-4">
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Accès Code Source</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-white">{{ projet.accesCodeSource ?? '-' }}</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Accès Environnement</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-white">{{ projet.accesEnvironnement ?? '-' }}</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Technologies</dt>
							<dd class="mt-1">
								{% if projet.technologie is not empty %}
									<div class="flex flex-wrap gap-2">
										{% for tech in projet.technologie %}
											<span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10 dark:bg-gray-700 dark:text-gray-300 dark:ring-gray-500/20">
												{{ tech.nom }}
											</span>
										{% endfor %}
									</div>
								{% else %}
									<span class="text-sm text-gray-900 dark:text-white">-</span>
								{% endif %}
								
								
								
							</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Hébergement</dt>
							<dd class="mt-1">
								{% if projet.hebergement is not empty %}
									<div class="flex flex-wrap gap-2">
										{% for heberg in projet.hebergement %}
											<span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10 dark:bg-purple-500/10 dark:text-purple-400 dark:ring-purple-500/20">
												{{ heberg.fournisseur }}
											</span>
										{% endfor %}
									</div>
								{% else %}
									<span class="text-sm text-gray-900 dark:text-white">-</span>
								{% endif %}
								
							</dd>
						</div>
					</dl>
				</div>

				<!-- Équipe -->
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Équipe
					</h2>
					<dl class="space-y-4">
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Développeurs</dt>
							<dd class="mt-1">
								{% if projet.developpeur is not empty %}
									<div class="flex flex-wrap gap-2">
										{% for dev in projet.developpeur %}
											<span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 dark:bg-indigo-500/10 dark:text-indigo-400 dark:ring-indigo-500/20">
												{{ dev}}
											</span>
										{% endfor %}
									</div>
								{% else %}
									<span class="text-sm text-gray-900 dark:text-white">-</span>
								{% endif %}
							</dd>
						</div>
						<!-- Développeur Principal -->
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Développeur Principal</dt>
							
							<span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700  ring-inset ring-green-700/10 dark:bg-green-500/10 dark:text-green-400 dark:ring-green-500/20">
												{{ projet.developpeurPrincipal ? projet.developpeurPrincipal.nom ~ ' ' ~ projet.developpeurPrincipal.prenom : '-' }}
											</span>
						</div>

						<!-- Suivi Par -->
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Suivi Par</dt>
							
							<span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700  ring-inset ring-red-700/10 dark:bg-red-500/10 dark:text-red-400 dark:ring-red-500/20">
												{{ projet.suiviPar ? projet.suiviPar.nom ~ ' ' ~ projet.suiviPar.prenom : '-' }}
											</span>
						</div>

						<!-- Commercial -->
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Commercial</dt>
							
							<span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700  ring-inset ring-indigo-700/10 dark:bg-indigo-500/10 dark:text-indigo-400 dark:ring-indigo-500/20">
												{{ projet.commercial ? projet.commercial.nom ~ ' ' ~ projet.commercial.prenom : '-' }}
											</span>
						</div>
					</dl>
				</div>

				<!-- Dates & Planning -->
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Dates & Planning
					</h2>
					<dl class="space-y-4">
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Date de Commande</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-white">
								{{ projet.dateCommande ? projet.dateCommande|date('d/m/Y') : '-' }}
							</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Date de Livraison</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-white">
								{{ projet.dateLivraison ? projet.dateLivraison|date('d/m/Y') : '-' }}
							</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Risque de Livraison</dt>
							<dd class="mt-1 text-sm text-gray-900 dark:text-white">{{ projet.risqueLivraison ?? '-' }}</dd>
						</div>
					</dl>
				</div>

				<!-- Client & Statut -->
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6 lg:col-span-2">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Client & Statut
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<dl class="space-y-4">
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">État du Projet</dt>
								<dd class="mt-2 flex flex-col gap-2">
									<div class="flex items-center">
										{% if projet.projetTeste %}
											<svg class="h-5 w-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
											</svg>
										{% else %}
											<svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
											</svg>
										{% endif %}
										<span class="text-sm text-gray-900 dark:text-white">Projet Testé</span>
									</div>
									<div class="flex items-center">
										{% if projet.projetValide %}
											<svg class="h-5 w-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
											</svg>
										{% else %}
											<svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
											</svg>
										{% endif %}
										<span class="text-sm text-gray-900 dark:text-white">Projet Validé</span>
									</div>
								</dd>
							</div>
						</dl>
						<dl class="space-y-4">
							<div>
								<dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Statut Client</dt>
								<dd class="mt-2 flex flex-col gap-2">
									<div class="flex items-center">
										{% if projet.clientGratuite %}
											<svg class="h-5 w-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
											</svg>
										{% else %}
											<svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
											</svg>
										{% endif %}
										<span class="text-sm text-gray-900 dark:text-white">Client Consommé Gratuité</span>
									</div>
									<div class="flex items-center">
										{% if projet.clientAmeliorations %}
											<svg class="h-5 w-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
											</svg>
										{% else %}
											<svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
											</svg>
										{% endif %}
										<span class="text-sm text-gray-900 dark:text-white">Client a Demandé Améliorations</span>
									</div>
								</dd>
							</div>
						</dl>
					</div>
				</div>

				{% include 'projets/_uptime.html.twig' %}

				<!-- Remarques -->
				{% if projet.remarques %}
				<div class="bg-white dark:bg-gray-800 rounded-lg  border border-gray-200 dark:border-gray-700 p-6 lg:col-span-2">
					<h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 pb-2 border-b border-gray-200 dark:border-gray-700">
						Remarques
					</h2>
					<p class="text-sm text-gray-900 dark:text-white whitespace-pre-wrap">{{ projet.remarques }}</p>
				</div>
				{% endif %}
			</div>

			<!-- Action Buttons -->
			<div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-200 dark:border-gray-700 pt-6">
				<a href="{{ path('app_societe_projets',{'id': projet.societe.id}) }}" class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-white dark:ring-gray-700 dark:hover:bg-gray-700">
					Retour
				</a>
				<button type="button" onclick="if(confirm('Êtes-vous sûr de vouloir supprimer ce projet?')) { document.getElementById('delete-form').submit(); }" class="rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
					Supprimer
				</button>
				<a href="{{ path('app_projets_update', {'id': projet.id}) }}" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-blue-500 dark:shadow-none dark:focus-visible:outline-blue-500">
					Modifier
				</a>
				
			</div>

			<!-- Hidden Delete Form -->
				<form id="delete-form" action="{{ path('app_projet_delete', {'id': projet.id}) }}" method="post" class="hidden">
					<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ projet.id) }}">
				</form>
		</div>
	</div >
</div>
{% endblock %}