	<script>
		document.addEventListener('DOMContentLoaded', function () {

			const projetTechnologie = document.getElementById('projet_technologie');
			const projetDeveloppeur = document.getElementById('projet_developpeur');
			const projetHebergement = document.getElementById('projet_hebergement');

			if (projetTechnologie && typeof TomSelect !== 'undefined') {
				new TomSelect("#projet_technologie", {
					plugins: ['remove_button'],
					create: false,
					maxItems: null,
					placeholder: 'Choisissez les technologies...',
					sortField: {
						field: "text",
						direction: "asc"
					},
					onInitialize: function () {
						this.control.classList.add('!border-none', '!px-0',);
					}
				});
			} else {
					console.error("Missing projet technologie or TomSelect library");
			}

			if (projetDeveloppeur && typeof TomSelect !== 'undefined') {
				new TomSelect("#projet_developpeur", {
					plugins: ['remove_button'],
					create: false,
					maxItems: null,
					placeholder: 'Choisissez les developpeurs...',
					sortField: {
						field: "text",
						direction: "asc"
					},
					onInitialize: function () {
						this.control.classList.add('!border-none', '!px-0',);
						this.wrapper.classList.add('!pr-[25px]');
					}
				});
			} else {
					console.error("Missing projet developpeur or TomSelect library");
			}

			if (projetHebergement && typeof TomSelect !== 'undefined') {
				new TomSelect("#projet_hebergement", {
					plugins: ['remove_button'],
					create: false,
					maxItems: null,
					placeholder: 'Choisissez les hebergements...',
					sortField: {
						field: "text",
						direction: "asc"
					},
					onInitialize: function () {
						this.control.classList.add('!border-none', '!px-0',);
						this.wrapper.classList.add('!pr-[25px]');
					}
				});
			} else {
					console.error("Missing projet hebergement or TomSelect library");
			}
		});
	</script>
