# Copy this file to ".env" (git-ignored) and fill in your own values.
#
# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate one with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Matches the PostgreSQL service of compose.yaml (the host port is random: docker compose port database 5432)
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/hubly?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# E-mails are queued: in production run `php bin/console messenger:consume async`.
# For local development use sync:// so e-mails (2FA codes) are sent immediately.
MESSENGER_TRANSPORT_DSN=sync://
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Pick ONE DSN and put your real credentials in your own ".env" only.
#
# Local testing without sending anything:
MAILER_DSN=null://null
# SMTP:
# MAILER_DSN=smtp://USER:PASSWORD@smtp.example.com:587?encryption=tls&auth_mode=login
# Gmail (development only, use an app password, never your account password):
# MAILER_DSN=gmail://GMAIL_ADDRESS:GMAIL_APP_PASSWORD@default?verify_peer=0
###< symfony/mailer ###

###> app/mail ###
# Sender address shown on every email the app sends (2FA codes, alerts)
MAIL_FROM=no-reply@example.com
# Who receives the hosting-expiration and URL-down alerts
ALERT_RECIPIENT=admin@example.com
###< app/mail ###

###> lexik/jwt-authentication-bundle ###
# Generate the key pair once: php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
###< lexik/jwt-authentication-bundle ###

###> app/encryption ###
# Encrypts hosting and project credentials in the database. Generate one:
#   php bin/console app:encryption:generate-key
# Never commit the real value and never lose it: without it the credentials cannot be read again.
APP_ENCRYPTION_KEY=
###< app/encryption ###

###> symfony/slack-notifier ###
# Optional: alerts in a Slack channel. Example: slack://TOKEN@default?channel=alerts
SLACK_DSN=null://null
###< symfony/slack-notifier ###
